# Copy to .env and fill in. NEVER commit .env.
# Local setup creates these roles/databases with api/scripts/create_dev_db.sql.

ENVIRONMENT=development            # development | test | production

# Runtime API connection: the non-owner role, so Postgres row-level security applies.
DATABASE_URL=postgresql+psycopg://smayaa_app:CHANGE_ME@localhost:5432/smayaa
# Alembic migrations: the schema-owner role.
MIGRATION_DATABASE_URL=postgresql+psycopg://smayaa_owner:CHANGE_ME@localhost:5432/smayaa

# Used by pytest (separate database, same two roles).
TEST_DATABASE_URL=postgresql+psycopg://smayaa_app:CHANGE_ME@localhost:5432/smayaa_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://smayaa_owner:CHANGE_ME@localhost:5432/smayaa_test

# At least 32 random characters. Generate e.g. with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_OF_32_PLUS_CHARS

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
